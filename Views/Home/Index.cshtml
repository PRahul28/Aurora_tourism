@{
    ViewData["Title"] = "Hotel & Tourism";
}

<!-- NAVBAR -->
<nav class="navbar">
    <div class="navbar-logo">AURORA</div>

    <div class="navbar-links">
        <a href="#about">About</a>
        <a href="#rooms">Rooms</a>
        <a href="#amenities">Amenities</a>
        <a href="#explore">Explore</a>
        <a href="#contact">Contact</a>
    </div>

    <a href="#booking" class="navbar-button">Book Your Stay</a>
</nav>


<!-- HERO -->
<section class="hero">

    <div class="hero-content">

        <p class="hero-label">WELCOME TO AURORA</p>

        <h1>
            Stay Somewhere<br>
            <span>Worth Remembering.</span>
        </h1>

        <p class="hero-description">
            Experience exceptional hospitality, elegant spaces,
            and unforgettable journeys in the heart of your destination.
        </p>

        <div class="hero-buttons">
            <a href="#booking" class="primary-button">Plan Your Stay</a>
            <a href="#explore" class="secondary-button">Explore Destination</a>
        </div>

    </div>

</section>


<!-- ABOUT -->
<section class="section" id="about">

    <div class="section-heading">
        <p class="section-label">ABOUT US</p>

        <h2>
            More Than Just<br>
            <span>A Place to Stay.</span>
        </h2>
    </div>

    <div class="about-content">

        <div class="about-text">

            <p>
                Welcome to Aurora, where thoughtful hospitality meets
                modern comfort. Designed for travelers who appreciate
                beautiful surroundings and exceptional service, our hotel
                offers a peaceful place to stay while keeping you close
                to everything worth discovering.
            </p>

            <p>
                Whether you're travelling for business, enjoying a family
                holiday, or looking for a weekend escape, every detail of
                your stay is designed to make your journey comfortable
                and memorable.
            </p>

        </div>

        <div class="stats">

            <div class="stat">
                <strong>50+</strong>
                <span>Rooms & Suites</span>
            </div>

            <div class="stat">
                <strong>4.8</strong>
                <span>Guest Rating</span>
            </div>

            <div class="stat">
                <strong>24/7</strong>
                <span>Guest Service</span>
            </div>

            <div class="stat">
                <strong>10+</strong>
                <span>Years of Hospitality</span>
            </div>

        </div>

    </div>

</section>


<!-- ROOMS -->
<section class="section rooms-section" id="rooms">

    <div class="section-heading center">

        <p class="section-label">ACCOMMODATION</p>

        <h2>
            Rooms Designed<br>
            <span>For Your Comfort.</span>
        </h2>

        <p>
            Relax in thoughtfully designed spaces with everything
            you need for a comfortable stay.
        </p>

    </div>


    <div class="rooms-grid">

        <div class="room-card">

            <div class="room-image room-one"></div>

            <div class="room-info">

                <p class="room-type">01 / DELUXE</p>

                <h3>Deluxe Room</h3>

                <p>
                    A comfortable and elegant room designed for
                    relaxing stays and peaceful nights.
                </p>

                <div class="room-details">
                    <span>2 Guests</span>
                    <span>King Bed</span>
                    <span>City View</span>
                </div>

                <div class="room-bottom">
                    <strong>₹4,999 <small>/ night</small></strong>
                    <a href="#booking">View Room →</a>
                </div>

            </div>

        </div>


        <div class="room-card">

            <div class="room-image room-two"></div>

            <div class="room-info">

                <p class="room-type">02 / PREMIUM</p>

                <h3>Premium Suite</h3>

                <p>
                    Spacious interiors, refined details and a
                    separate living area for a premium experience.
                </p>

                <div class="room-details">
                    <span>3 Guests</span>
                    <span>King Bed</span>
                    <span>Living Area</span>
                </div>

                <div class="room-bottom">
                    <strong>₹7,999 <small>/ night</small></strong>
                    <a href="#booking">View Room →</a>
                </div>

            </div>

        </div>


        <div class="room-card">

            <div class="room-image room-three"></div>

            <div class="room-info">

                <p class="room-type">03 / FAMILY</p>

                <h3>Family Suite</h3>

                <p>
                    Spacious accommodation designed for families
                    travelling together.
                </p>

                <div class="room-details">
                    <span>4 Guests</span>
                    <span>2 Bedrooms</span>
                    <span>Living Area</span>
                </div>

                <div class="room-bottom">
                    <strong>₹10,999 <small>/ night</small></strong>
                    <a href="#booking">View Room →</a>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- AMENITIES -->
<section class="section amenities-section" id="amenities">

    <div class="section-heading">

        <p class="section-label">HOTEL AMENITIES</p>

        <h2>
            Everything You Need.<br>
            <span>Nothing You Don't.</span>
        </h2>

    </div>


    <div class="amenities-grid">

        <div class="amenity">
            <span class="amenity-number">01</span>
            <h3>Free Wi-Fi</h3>
            <p>High-speed internet throughout the property.</p>
        </div>

        <div class="amenity">
            <span class="amenity-number">02</span>
            <h3>Fine Dining</h3>
            <p>Enjoy local and international cuisine.</p>
        </div>

        <div class="amenity">
            <span class="amenity-number">03</span>
            <h3>Swimming Pool</h3>
            <p>Relax and unwind beside our pool.</p>
        </div>

        <div class="amenity">
            <span class="amenity-number">04</span>
            <h3>24/7 Service</h3>
            <p>Our team is available whenever you need us.</p>
        </div>

        <div class="amenity">
            <span class="amenity-number">05</span>
            <h3>Free Parking</h3>
            <p>Convenient and secure parking for guests.</p>
        </div>

        <div class="amenity">
            <span class="amenity-number">06</span>
            <h3>Fitness Center</h3>
            <p>Stay active throughout your visit.</p>
        </div>

    </div>

</section>


<!-- EXPLORE -->
<section class="section explore-section" id="explore">

    <div class="section-heading center">

        <p class="section-label">EXPLORE</p>

        <h2>
            Discover What Lies<br>
            <span>Beyond The Hotel.</span>
        </h2>

        <p>
            Your stay is only the beginning. Discover the culture,
            history and experiences waiting outside our doors.
        </p>

    </div>


    <div class="explore-grid">

        <div class="explore-card explore-one">
            <div>
                <p>01</p>
                <h3>Heritage</h3>
                <span>Discover historic landmarks and architecture →</span>
            </div>
        </div>

        <div class="explore-card explore-two">
            <div>
                <p>02</p>
                <h3>Culture</h3>
                <span>Experience local traditions and cuisine →</span>
            </div>
        </div>

        <div class="explore-card explore-three">
            <div>
                <p>03</p>
                <h3>Adventure</h3>
                <span>Find unforgettable experiences nearby →</span>
            </div>
        </div>

    </div>

</section>


<!-- WHY US -->
<section class="section why-section">

    <div class="why-content">

        <div>
            <p class="section-label">WHY AURORA</p>

            <h2>
                Hospitality With<br>
                <span>A Human Touch.</span>
            </h2>
        </div>

        <div class="why-text">

            <p>
                We believe great hospitality is about more than
                beautiful rooms. It's about how you're welcomed,
                how you're cared for, and how you remember your stay.
            </p>

            <p>
                From the moment you arrive to the moment you leave,
                our team is here to make every part of your journey
                effortless.
            </p>

        </div>

    </div>

</section>


<!-- BOOKING / EXISTING FORM -->
<section class="booking-section" id="booking">

    <div class="booking-container">

        <div class="booking-intro">

            <p class="section-label">GET IN TOUCH</p>

            <h2>
                Plan Your<br>
                <span>Perfect Stay.</span>
            </h2>

            <p>
                Tell us a little about your trip and our team
                will get back to you shortly.
            </p>

        </div>


        <div class="form-card">

            <form id="submissionForm">

                <div class="mb-3">
                    <label for="name">Name</label>

                    <input
                        type="text"
                        id="name"
                        class="form-control"
                        placeholder="Enter your name"
                        required>
                </div>

                <div class="mb-3">
                    <label for="email">Email</label>

                    <input
                        type="email"
                        id="email"
                        class="form-control"
                        placeholder="you@example.com"
                        required>
                </div>

                <div class="mb-3">
                    <label for="phone">Phone</label>

                    <input
                        type="text"
                        id="phone"
                        class="form-control"
                        placeholder="Enter phone number">
                </div>

                <div class="mb-4">
                    <label for="message">Message</label>

                    <textarea
                        id="message"
                        class="form-control"
                        rows="5"
                        placeholder="Tell us about your trip..."></textarea>
                </div>

                <button
                    type="submit"
                    id="submitButton"
                    class="btn btn-light w-100">
                    Send Inquiry
                </button>

            </form>

            <div id="statusMessage"></div>

        </div>

    </div>

</section>


<!-- CONTACT -->
<section class="contact-section" id="contact">

    <div class="contact-container">

        <div>
            <p class="section-label">VISIT US</p>

            <h2>
                Your Next<br>
                <span>Journey Starts Here.</span>
            </h2>
        </div>

        <div class="contact-details">

            <p>
                123 Hotel Street<br>
                Ahmedabad, Gujarat<br>
                India
            </p>

            <p>
                +91 XXXXX XXXXX<br>
                reservations@aurora.com
            </p>

        </div>

    </div>

</section>

